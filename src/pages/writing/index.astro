---
import Base from "../../layouts/Base.astro";
import { fmt, posts } from "../../lib";

const list = await posts();
const description = "Notes. If I did not measure it, I do not claim it.";
---
<Base title="Notes · Manmohan Singh Charan" description={description}>
  <h1>Notes</h1>
  <p class="credentials">{description}</p>
  {list.length === 0 && <p>Nothing posted yet. <a href="/rss.xml">RSS</a>.</p>}
  <ul class="index">
    {list.map((note) => (
      <li>
        <a href={`/writing/${note.id}/`}>
          <span class="top">
            <span class="co">{note.data.title}</span>
            <time class="when" datetime={note.data.date.toISOString()}>{fmt(note.data.date)}</time>
          </span>
          <span class="line">{note.data.description}</span>
        </a>
      </li>
    ))}
  </ul>
</Base>
