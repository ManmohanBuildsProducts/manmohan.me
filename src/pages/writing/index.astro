---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { posts } from '../../lib';

const list = await posts();
const title = 'Writing · Manmohan Singh Charan';
const description = 'Notes on building products with AI, and what I learn along the way.';
---
<Base title={title} description={description} canonicalPath="/writing/">
  <main id="main">
    <div class="row page-intro">
      <div aria-hidden="true"></div>
      <div>
        <h1>Writing</h1>
        <p class="lead">Notes on building products with AI, and what I learn along the way.</p>
        {list.length === 0 ? (
          <p class="empty">Writing soon.</p>
        ) : (
          <PostList posts={list} showDescription />
        )}
        <p class="more"><a class="ln" href="/rss.xml">RSS</a></p>
      </div>
    </div>
  </main>
</Base>
