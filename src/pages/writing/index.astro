---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { posts } from '../../lib';
const list = await posts();
---
<Base title="Notes · Manmohan Singh Charan" description="Notes by Manmohan Singh Charan on agents, search, and shipping products.">
  <p class="kick">Notes</p>
  <h1>Writing</h1>
  <p class="lede">Short notes on the work. New pieces land here and in the RSS feed.</p>
  <PostList posts={list} />
  <p class="more"><a href="/rss.xml">RSS</a></p>
</Base>
<style>
.lede{color:var(--muted);max-width:46ch;margin:0}
.more{margin:28px 0 0;font-size:.82rem;letter-spacing:.08em;text-transform:uppercase}
.more a{color:var(--gold);text-decoration:none;border-bottom:1px solid rgba(243,200,113,.45)}
.more a:hover{border-bottom-color:var(--gold)}
</style>
