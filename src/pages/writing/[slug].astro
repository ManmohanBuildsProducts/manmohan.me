---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { fmt, posts } from "../../lib";

export async function getStaticPaths() {
  return (await posts()).map((note) => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);
---
<Base title={`${note.data.title} · Manmohan Singh Charan`} description={note.data.description} type="article">
  <article class="story">
    <p class="back"><a href="/writing/">Notes</a></p>
    <h1>{note.data.title}</h1>
    <time class="posted" datetime={note.data.date.toISOString()}>{fmt(note.data.date)}</time>
    <div class="prose"><Content /></div>
  </article>
</Base>
