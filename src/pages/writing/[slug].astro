---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { fmt, isoDate, posts } from '../../lib';

export async function getStaticPaths() {
  return (await posts()).map((p) => ({ params: { slug: p.id } }));
}

const { slug } = Astro.params;
const entry = (await posts()).find((p) => p.id === slug);
if (!entry) throw new Error(`Missing post ${slug}`);
const { Content } = await render(entry);
const published = isoDate(entry.data.pubDate);
const url = new URL(`/writing/${entry.id}/`, Astro.site).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: published,
  author: {
    '@type': 'Person',
    name: 'Manmohan Singh Charan',
    url: 'https://manmohan.work/',
  },
  mainEntityOfPage: url,
};
---
<Base
  title={`${entry.data.title} · Manmohan Singh Charan`}
  description={entry.data.description}
  type="article"
  canonicalPath={`/writing/${entry.id}/`}
  published={published}
  jsonLd={jsonLd}
>
  <main id="main">
    <article class="row article">
      <p class="crumb"><a class="ln" href="/writing">All writing</a></p>
      <div>
        <h1>{entry.data.title}</h1>
        <p class="when"><time datetime={published}>{fmt(entry.data.pubDate)}</time></p>
        {entry.data.tags && entry.data.tags.length > 0 && <p class="tags">{entry.data.tags.join(' · ')}</p>}
        <div class="prose">
          <Content />
        </div>
      </div>
    </article>
  </main>
</Base>
