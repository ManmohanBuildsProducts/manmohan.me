---
import Base from "../layouts/Base.astro";
import { person, projects, roles } from "../data/site";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: person.name,
  url: "https://manmohan.work/",
  jobTitle: "Lead PM",
  worksFor: { "@type": "Organization", name: "GobbleCube" },
  alumniOf: { "@type": "CollegeOrUniversity", name: "IIT Roorkee" },
  sameAs: [person.x, person.github, person.linkedin],
};

const badho = roles.find((role) => role.slug === "badho");
---
<Base title={person.name} description={person.sentence}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <header class="hero" aria-labelledby="name">
    <h1 id="name">{person.name}</h1>
    <p class="thesis">{person.sentence}</p>
    <p class="proof">
      {person.proof}
      <button class="fn-mark" type="button" aria-expanded="false" data-fn>
        <svg class="turtle" viewBox="0 0 24 14" aria-hidden="true"><ellipse cx="12" cy="8" rx="7" ry="4" fill="none" stroke="currentColor" stroke-width="1.4"/><circle cx="4" cy="8" r="1.3" fill="currentColor"/><path d="M12 4 v-2 M9 5 l-1-2 M15 5 l1-2" stroke="currentColor" stroke-width="1.2" fill="none"/></svg>
        <span class="sr">Footnote</span>
      </button>
    </p>
    <p class="footnote" id="fn" hidden>The world, it is said, rests on a turtle. This page rests on a smaller one.<sup>1</sup></p>
  </header>

  <section class="block" id="work" aria-labelledby="work-title">
    <h2 id="work-title">Work</h2>
    <ol class="jobs">
      {roles.map((role) => (
        <li>
          <a href={`/work/${role.slug}/`}>
            <span class="job-top">
              <span class="company">
                {role.company}
                <span class="pips" aria-hidden="true"><i></i><i></i><i></i></span>
                <span class="age">Age advanced!</span>
              </span>
              <span class="dates">{role.dates}</span>
            </span>
            <span class="role">{role.title}</span>
            <span class="bet">{role.outcome}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  {badho && (
    <section class="block wanted" id="case" aria-labelledby="case-title">
      <p class="kicker">Wanted</p>
      <h2 id="case-title">Case study</h2>
      <p class="case-name"><a href={`/work/${badho.slug}/`}>Search that does not wait</a></p>
      <p class="case-line">He would not wait for a model to fix a typo. So the model stayed off the request.</p>
      <p><a href={`/work/${badho.slug}/`}>Read the case study</a></p>
    </section>
  )}

  <section class="block" id="now" aria-labelledby="now-title">
    <h2 id="now-title">Building now</h2>
    <p class="tools">I use Grok Bot, Cursor, and Claude.</p>
    <ul class="now">
      {projects.map((project) => (
        <li>
          {project.href ? (
            <a href={project.href}>{project.name}</a>
          ) : (
            <span class="plain">{project.name}</span>
          )}
          <span class="dash" aria-hidden="true"> — </span>
          <span>{project.line}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="block" id="writing" aria-labelledby="writing-title">
    <h2 id="writing-title">Writing</h2>
    <p><a href="/writing/agent-economy/">The agent economy</a>. Questions I am willing to work on. Not products.</p>
    <p><button class="fn-mark" type="button" data-map>I solemnly swear…</button></p>
    <p class="prints" aria-hidden="true">👣 👣 👣 👣 👣</p>
  </section>

  <section class="block" id="contact" aria-labelledby="contact-title">
    <h2 id="contact-title">What I want</h2>
    <p class="ask">I’m looking for PM roles at AI labs and AI-first companies. Remote from India, or relocation.</p>
    <a class="button" href={person.linkedin} rel="me" data-bounce>LinkedIn</a>
  </section>
  <p class="toast" data-toast role="status"></p>
  <button class="hat" type="button" data-hat aria-label="A small straw hat" hidden>
    <svg viewBox="0 0 24 14" aria-hidden="true"><path d="M2 9 Q12 2 22 9" fill="none" stroke="currentColor" stroke-width="1.6"/><ellipse cx="12" cy="9" rx="10" ry="2.2" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
  </button>
</Base>
<script>
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const fine = matchMedia("(hover: hover) and (pointer: fine)").matches;
  const toast = document.querySelector("[data-toast]");
  let toastTimer = 0;
  function say(text) {
    if (!toast) return;
    toast.textContent = text;
    toast.classList.add("show");
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toast.classList.remove("show"), 1600);
  }
  document.querySelector("[data-fn]")?.addEventListener("click", (event) => {
    const button = event.currentTarget;
    const note = document.getElementById("fn");
    if (!note || !(button instanceof HTMLElement)) return;
    const open = note.hasAttribute("hidden");
    note.toggleAttribute("hidden", !open);
    button.setAttribute("aria-expanded", open ? "true" : "false");
  });
  document.querySelector("[data-map]")?.addEventListener("click", () => {
    document.body.classList.toggle("mapped");
  });
  const hat = document.querySelector("[data-hat]");
  document.querySelector("[data-bounce]")?.addEventListener("mouseenter", (event) => {
    if (reduce) return;
    const button = event.currentTarget;
    if (button instanceof HTMLElement) button.textContent = "Let’s talk";
  });
  document.querySelector("[data-bounce]")?.addEventListener("mouseleave", (event) => {
    const button = event.currentTarget;
    if (button instanceof HTMLElement) button.textContent = "LinkedIn";
  });
  const konami = ["ArrowUp","ArrowUp","ArrowDown","ArrowDown","ArrowLeft","ArrowRight","ArrowLeft","ArrowRight","b","a"];
  let keys = [];
  let letters = "";
  addEventListener("keydown", (event) => {
    if (event.target instanceof HTMLInputElement || event.target instanceof HTMLTextAreaElement) return;
    keys = [...keys, event.key].slice(-10);
    if (konami.every((key, index) => keys[keys.length - konami.length + index] === key)) {
      document.body.classList.add("merry");
      if (hat instanceof HTMLElement) hat.hidden = false;
      say("Age advanced!");
    }
    if (event.key.length === 1) letters = (letters + event.key.toLowerCase()).slice(-3);
    if (letters === "aoe") say("Age advanced!");
  });
  if (fine && !reduce) {
    const dots = Array.from({ length: 3 }, () => {
      const dot = document.createElement("span");
      dot.className = "trail";
      dot.setAttribute("aria-hidden", "true");
      document.body.append(dot);
      return dot;
    });
    const points = dots.map(() => ({ x: 0, y: 0 }));
    addEventListener("pointermove", (event) => {
      points[0] = { x: event.clientX, y: event.clientY };
    });
    let frame = 0;
    const step = () => {
      for (let i = 1; i < points.length; i++) {
        points[i].x += (points[i - 1].x - points[i].x) * 0.35;
        points[i].y += (points[i - 1].y - points[i].y) * 0.35;
      }
      dots.forEach((dot, i) => {
        dot.style.left = points[i].x + "px";
        dot.style.top = points[i].y + "px";
      });
      frame = requestAnimationFrame(step);
    };
    frame = requestAnimationFrame(step);
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) cancelAnimationFrame(frame);
    });
  }
</script>
