---
import Base from "../layouts/Base.astro";
import { now, person, roles } from "../data/site";
import { posts } from "../lib";

const notes = await posts();

const sameAs = [person.x, person.github, person.linkedin];
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: person.name,
  url: "https://manmohan.work/",
  email: `mailto:${person.email}`,
  jobTitle: "Lead PM",
  worksFor: { "@type": "Organization", name: "GobbleCube" },
  alumniOf: { "@type": "CollegeOrUniversity", name: "IIT Roorkee" },
  sameAs,
};
---
<Base title={person.name} description={person.sentence}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <h1>{person.name}</h1>
  <p class="lede">{person.sentence}</p>
  <p class="credentials">{person.credentials}</p>

  <section id="now" aria-labelledby="now-title">
    <h2 id="now-title" class="label">Now</h2>
    <div class="prose">
      {now.map((paragraph) => (
        <p>
          {paragraph.map((span) =>
            span.href ? <a href={span.href}>{span.text}</a> : span.text
          )}
        </p>
      ))}
    </div>
  </section>

  <section id="work" aria-labelledby="work-title">
    <h2 id="work-title" class="label">Work</h2>
    <ol class="index">
      {roles.map((role) => (
        <li>
          <a href={`/work/${role.slug}/`}>
            <span class="top">
              <span class="co">{role.company}</span>
              <span class="when">{role.dates}</span>
            </span>
            <span class="role">{role.title}</span>
            <span class="line">{role.line}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  {notes.length > 0 && (
    <section id="notes" aria-labelledby="notes-title">
      <h2 id="notes-title" class="label">Notes</h2>
      <ul class="index">
        {notes.map((note) => (
          <li>
            <a href={`/writing/${note.id}/`}>
              <span class="co">{note.data.title}</span>
              <span class="line">{note.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section id="contact" aria-labelledby="contact-title">
    <h2 id="contact-title" class="label">Contact</h2>
    <ul class="links">
      <li><a href={person.x} rel="me">{person.xLabel}</a></li>
      <li><a href={person.github} rel="me">{person.githubLabel}</a></li>
      <li><a href={person.linkedin} rel="me">{person.linkedinLabel}</a></li>
      <li><a href={`mailto:${person.email}`}>{person.email}</a></li>
    </ul>
  </section>
</Base>
