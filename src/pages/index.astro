---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { posts } from '../lib';

const essays = await posts();
const title = 'Manmohan Singh Charan · Product manager';
const description = 'Manmohan Singh Charan, Lead PM at GobbleCube. Seven years in product: at scale, from zero, and now from one to ten.';

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Manmohan Singh Charan',
  url: 'https://manmohan.work/',
  email: 'mailto:manmohanbuildsproducts@gmail.com',
  jobTitle: 'Lead PM',
  worksFor: { '@type': 'Organization', name: 'GobbleCube' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'IIT Roorkee' },
  homeLocation: { '@type': 'Place', name: 'Gurugram, India' },
  sameAs: [
    'https://www.linkedin.com/in/maciitr',
    'https://x.com/ManmohanBuilds',
    'https://github.com/ManmohanBuildsProducts',
  ],
};
---
<Base title={title} description={description} jsonLd={person}>
  <main id="main">
    <div class="row intro">
      <div aria-hidden="true"></div>
      <div>
        <p class="name">Manmohan Singh Charan <span><span class="dot-m" aria-hidden="true">· </span>Lead PM at GobbleCube · IIT Roorkee</span></p>
        <h1>The PM who ships AI to production.</h1>
        <p class="lede">Seven years in product: at scale, from zero, and now from one to ten.</p>
        <p class="summary">I learned operations at scale at Blinkit. I co-founded two companies from zero, Tago Care and Badho. Now I’m at GobbleCube, growing an AI-first product. On the side, I build with AI. <a class="ln" href="https://github.com/ManmohanBuildsProducts">It’s on GitHub<span class="ar" aria-hidden="true">↗</span></a></p>
      </div>
    </div>

    <section class="row" aria-labelledby="work-h">
      <h2 id="work-h">Work</h2>
      <ol class="work">
        <li><span class="yr">2019–20</span><p><a class="ln co" href="https://blinkit.com">Blinkit</a> <span class="role">· Associate Product Manager, offline stores</span><span class="what">Store operations at scale.</span></p></li>
        <li><span class="yr">2021</span><p><a class="ln co" href="https://bijak.in">Bijak</a> <span class="role">· Product consultant / Senior PM</span><span class="what">A new product line for mandi trade.</span></p></li>
        <li><span class="yr">2021–22</span><p><a class="ln co" href="https://in.linkedin.com/company/tagocare">Tago Care</a> <span class="role">· Co-founder & Head of Product</span><span class="what">A health locker for families.</span></p></li>
        <li><span class="yr">2022–26</span><p><a class="ln co" href="https://play.google.com/store/apps/details?id=com.badhobuyer">Badho</a> <span class="role">· Co-founder & Head of Product</span><span class="what">A digital channel for general trade.</span></p></li>
        <li><span class="yr">2026–</span><p><a class="ln co" href="https://gobblecube.ai">GobbleCube</a> <span class="role">· Lead PM</span><span class="what">AI-first pricing and promotions.</span></p></li>
      </ol>
    </section>

    <section class="row" aria-labelledby="writing-h" id="writing">
      <h2 id="writing-h">Writing</h2>
      <div>
        <p class="lead">Notes on building products with AI, and what I learn along the way.</p>
        {essays.length === 0 ? (
          <p class="empty">Writing soon.</p>
        ) : (
          <>
            <PostList posts={essays.slice(0, 3)} />
            <p class="more"><a class="ln" href="/writing">All writing →</a><a class="ln" href="/rss.xml">RSS</a></p>
          </>
        )}
      </div>
    </section>

    <section class="row" aria-labelledby="contact-h" id="contact">
      <h2 id="contact-h">Contact</h2>
      <div>
        <p class="ask">I’m looking for PM roles at AI labs and AI-first companies, remote from India or with relocation.</p>
        <p class="summary">The fastest way to reach me is email.</p>
        <ul class="links">
          <li><a class="ln primary" href="mailto:manmohanbuildsproducts@gmail.com">manmohanbuildsproducts@gmail.com</a></li>
          <li><a class="ln" href="https://www.linkedin.com/in/maciitr">LinkedIn<span class="ar" aria-hidden="true">↗</span></a></li>
          <li><a class="ln" href="https://x.com/ManmohanBuilds">X<span class="ar" aria-hidden="true">↗</span></a></li>
          <li><a class="ln" href="https://github.com/ManmohanBuildsProducts">GitHub<span class="ar" aria-hidden="true">↗</span></a></li>
        </ul>
      </div>
    </section>
  </main>
</Base>
