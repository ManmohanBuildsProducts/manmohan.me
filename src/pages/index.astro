---
import Base from "../layouts/Base.astro";
import { creed, person, projects, roles } from "../data/site";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: person.name,
  url: "https://manmohan.work/",
  jobTitle: "Lead PM",
  worksFor: { "@type": "Organization", name: "GobbleCube" },
  alumniOf: { "@type": "CollegeOrUniversity", name: "IIT Roorkee" },
  sameAs: [person.x, person.github, person.linkedin],
};

const alt = "A painted town: a grocery shop, a mandi stall, a clinic, a trade hall, and a building still going up.";
---
<Base title={person.name} description={person.sentence} wide>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="hero" aria-labelledby="name">
    <div class="hero-copy">
      <h1 id="name">{person.name}</h1>
      <p class="thesis">{person.sentence}</p>
      <div class="hero-bio">
        <p>{person.bio}</p>
        <p>{person.years}</p>
      </div>
    </div>
    <figure class="hero-figure">
      <picture>
        <source
          type="image/avif"
          srcset="/hero/town-480.avif 480w, /hero/town-768.avif 768w, /hero/town-1080.avif 1080w"
          sizes="(min-width: 900px) 460px, 92vw"
        />
        <source
          type="image/webp"
          srcset="/hero/town-480.webp 480w, /hero/town-768.webp 768w, /hero/town-1080.webp 1080w"
          sizes="(min-width: 900px) 460px, 92vw"
        />
        <img
          src="/hero/town-768.webp"
          width="1080"
          height="816"
          alt={alt}
          fetchpriority="high"
        />
      </picture>
    </figure>
  </section>

  <div class="column">
    <section class="block" id="creed" aria-labelledby="creed-title">
      <h2 id="creed-title">Notes on building</h2>
      <ul class="creed">
        {creed.map((line) => <li>{line}</li>)}
      </ul>
    </section>

    <section class="block" id="work" aria-labelledby="work-title">
      <h2 id="work-title">Work</h2>
      <ol class="jobs">
        {roles.map((role) => (
          <li>
            <a href={`/work/${role.slug}/`}>
              <span class="job-top">
                <span class="company">{role.company}</span>
                <span class="dates">{role.dates}</span>
              </span>
              <span class="role">{role.title}</span>
              <span class="bet">{role.outcome}</span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section class="block" id="now" aria-labelledby="now-title">
      <h2 id="now-title">Building now</h2>
      <p class="tools">I use Grok Bot, Cursor, and Claude.</p>
      <ul class="now">
        {projects.map((project) => (
          <li>
            {project.href ? (
              <a href={project.href}>{project.name}</a>
            ) : (
              <span class="plain">{project.name}</span>
            )}
            <span class="dash" aria-hidden="true"> — </span>
            <span>{project.line}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="block" id="contact" aria-labelledby="contact-title">
      <h2 id="contact-title">Contact</h2>
      <p class="contact-line">
        <a href={person.x} rel="me">X</a>
        <span aria-hidden="true"> · </span>
        <a href={person.github} rel="me">GitHub</a>
        <span aria-hidden="true"> · </span>
        <a href={person.linkedin} rel="me">LinkedIn</a>
      </p>
    </section>
  </div>
</Base>
