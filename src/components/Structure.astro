---
interface Props {
  kind: "depot" | "mandi" | "care" | "market" | "scaffold";
  wonder?: boolean;
}
const { kind, wonder = false } = Astro.props;
const s = { stroke: "#2A2216", "stroke-width": "1.25" };
const wall = "#F4E7CC";
const roof = "#E9B949";
const wood = "#8A5A32";
---

{kind === "depot" && (
  <g>
    <rect x="-30" y="-36" width="60" height="36" fill={wall} stroke={s.stroke} stroke-width={s["stroke-width"]} />
    <polygon points="-36,-36 0,-58 36,-36" fill={roof} stroke={s.stroke} stroke-width={s["stroke-width"]} />
    <rect x="-8" y="-20" width="16" height="20" fill={wood} />
    <rect x="-22" y="-28" width="10" height="8" fill="#F7F1E2" stroke={s.stroke} />
    <rect x="12" y="-28" width="10" height="8" fill="#F7F1E2" stroke={s.stroke} />
    <rect x="34" y="-14" width="14" height="14" fill={wood} stroke={s.stroke} />
    <rect x="38" y="-26" width="10" height="12" fill={wood} stroke={s.stroke} />
  </g>
)}

{kind === "mandi" && (
  <g>
    <line x1="-32" y1="0" x2="-32" y2="-40" stroke={wood} stroke-width="3.2" />
    <line x1="32" y1="0" x2="32" y2="-40" stroke={wood} stroke-width="3.2" />
    <polygon points="-42,-38 42,-38 32,-54 -32,-54" fill={roof} stroke={s.stroke} stroke-width={s["stroke-width"]} />
    <line x1="-18" y1="-38" x2="-14" y2="-54" stroke={wall} stroke-width="5" />
    <line x1="0" y1="-38" x2="0" y2="-54" stroke={wall} stroke-width="5" />
    <line x1="18" y1="-38" x2="14" y2="-54" stroke={wall} stroke-width="5" />
    <rect x="-28" y="-16" width="56" height="16" fill={wall} stroke={s.stroke} />
    <circle cx="-14" cy="-20" r="5.5" fill="#7FA650" />
    <circle cx="2" cy="-20" r="5.5" fill="#D9822B" />
    <circle cx="16" cy="-18" r="5.5" fill="#C0504D" />
  </g>
)}

{kind === "care" && (
  <g>
    <rect x="-28" y="-40" width="56" height="40" fill={wall} stroke={s.stroke} stroke-width={s["stroke-width"]} />
    <polygon points="-34,-40 0,-66 34,-40" fill={roof} stroke={s.stroke} stroke-width={s["stroke-width"]} />
    <path d="M0,-16 C -12,-26 -9,-36 0,-28 C 9,-36 12,-26 0,-16 Z" fill="#C0504D" />
    <rect x="-8" y="-18" width="8" height="18" fill={wood} />
    <rect x="14" y="-14" width="8" height="14" fill={wood} />
  </g>
)}

{kind === "market" && (
  <g>
    {wonder && <rect x="-78" y="4" width="156" height="8" fill={wall} stroke={s.stroke} />}
    {wonder && <rect x="-70" y="-4" width="140" height="8" fill={wall} stroke={s.stroke} />}
    <rect x="-54" y="-50" width="108" height="50" fill={wall} stroke={s.stroke} stroke-width={s["stroke-width"]} />
    <line x1="-38" y1="-8" x2="-38" y2="-44" stroke={s.stroke} stroke-width="2.2" />
    <line x1="-18" y1="-8" x2="-18" y2="-44" stroke={s.stroke} stroke-width="2.2" />
    <line x1="0" y1="-8" x2="0" y2="-44" stroke={s.stroke} stroke-width="2.2" />
    <line x1="18" y1="-8" x2="18" y2="-44" stroke={s.stroke} stroke-width="2.2" />
    <line x1="38" y1="-8" x2="38" y2="-44" stroke={s.stroke} stroke-width="2.2" />
    <polygon points="-60,-50 0,-76 60,-50" fill={roof} stroke={s.stroke} stroke-width={s["stroke-width"]} />
    <rect x="-60" y="-8" width="120" height="8" fill={wall} stroke={s.stroke} />
    {wonder && (
      <g>
        <path d="M -26 -70 A 26 26 0 0 1 26 -70 Z" fill={roof} stroke={s.stroke} />
        <line x1="0" y1="-96" x2="0" y2="-124" stroke={s.stroke} stroke-width="2" />
        <polygon points="0,-124 22,-116 0,-110" fill="#C0504D" />
      </g>
    )}
  </g>
)}

{kind === "scaffold" && (
  <g>
    <rect x="-32" y="-32" width="64" height="32" fill={wall} stroke={s.stroke} />
    <rect x="-32" y="-48" width="36" height="16" fill={wall} stroke={s.stroke} opacity="0.7" />
    <line x1="-40" y1="0" x2="-40" y2="-70" stroke={wood} stroke-width="2.2" />
    <line x1="-14" y1="0" x2="-14" y2="-70" stroke={wood} stroke-width="2.2" />
    <line x1="14" y1="0" x2="14" y2="-70" stroke={wood} stroke-width="2.2" />
    <line x1="40" y1="0" x2="40" y2="-70" stroke={wood} stroke-width="2.2" />
    <line x1="-42" y1="-24" x2="42" y2="-24" stroke={wood} stroke-width="2" />
    <line x1="-42" y1="-46" x2="42" y2="-46" stroke={wood} stroke-width="2" />
    <line x1="-42" y1="-68" x2="42" y2="-68" stroke={wood} stroke-width="2" />
    <line x1="54" y1="0" x2="54" y2="-96" stroke={s.stroke} stroke-width="2.6" />
    <line x1="62" y1="-96" x2="-8" y2="-96" stroke={s.stroke} stroke-width="2.6" />
    <g transform="translate(-8 -96)">
      <g class="hook">
        <line x1="0" y1="0" x2="0" y2="18" stroke={s.stroke} />
        <rect x="-8" y="16" width="13" height="8" fill={roof} stroke={s.stroke} />
      </g>
    </g>
  </g>
)}
