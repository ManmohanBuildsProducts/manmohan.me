---
import { searchReplay } from '../data/search-replay';

const first = searchReplay[0];
const rows = first.order.hybrid.map((id) => first.rows.find((row) => row.id === id)!);
---
<section id="watch" aria-labelledby="watch-title">
  <p class="kick">Part Index</p>
  <h2 id="watch-title">Watch it search</h2>
  <p class="lede">Illustrative replay. These queries, and the part each one expects, are from the public benchmark. The row order is a sketch of keyword versus embedding versus hybrid. It is not a recorded search, and it is not a score.</p>
  <div class="stage" data-watch>
    <div class="bar">
      <span data-kind>{first.kind}</span>
      <span>illustrative</span>
    </div>
    <p class="line">
      <span class="prompt" aria-hidden="true">›</span>
      <span class="mono" data-q>{first.q}</span>
      <span class="caret" aria-hidden="true"></span>
    </p>
    <div class="controls">
      <div role="radiogroup" aria-label="Retrieval">
        <button type="button" role="radio" data-mode="keyword" aria-checked="false" tabindex="-1">Keyword</button>
        <button type="button" role="radio" data-mode="embedding" aria-checked="false" tabindex="-1">Embedding</button>
        <button type="button" role="radio" data-mode="hybrid" aria-checked="true" tabindex="0">Hybrid</button>
      </div>
      <div class="queries" role="group" aria-label="Benchmark queries">
        {searchReplay.map((item, i) => (
          <button type="button" data-qi={i} aria-pressed={i === 0 ? 'true' : 'false'}>{item.q}</button>
        ))}
      </div>
      <button type="button" data-pause aria-pressed="false">Pause</button>
    </div>
    <ol class="rows" data-rows>
      {rows.map((row) => (
        <li data-id={row.id} data-q="0" class:list={{ 'is-expected': row.expected }}>
          <span class="nm">{row.name}</span>
          <span class="dt">{row.detail}</span>
        </li>
      ))}
    </ol>
    <p class="sr" data-live aria-live="polite"></p>
  </div>
  <p class="more">
    <a href="https://github.com/ManmohanBuildsProducts/auto-parts-search" target="_blank" rel="noopener noreferrer">Source <span class="sr">(opens in a new tab)</span></a>
    · <a href="https://github.com/ManmohanBuildsProducts/auto-parts-search/blob/master/data/hf_benchmark_dataset/benchmark_dev.json" target="_blank" rel="noopener noreferrer">Benchmark <span class="sr">(opens in a new tab)</span></a>
  </p>
</section>
<script>
  const el = document.querySelector('[data-watch]');
  if (el) {
    const load = () => { import('../scripts/watch-search.ts'); };
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          io.disconnect();
          load();
        }
      }, { rootMargin: '240px' });
      io.observe(el);
    } else {
      load();
    }
  }
</script>
<style>
section{padding:clamp(36px,6vh,64px) 0;border-top:1px solid var(--line)}
h2{font:300 clamp(1.8rem,3vw,2.4rem)/1.15 Newsreader,Georgia,serif;letter-spacing:-.02em;margin:.35em 0 .55em}
.lede{max-width:62ch;color:var(--muted);margin:0 0 1.25rem}
.stage{border:1px solid var(--line);border-radius:16px;background:#08080b;overflow:hidden}
.bar{display:flex;justify-content:space-between;gap:12px;padding:12px 16px;border-bottom:1px solid var(--line);font-size:.68rem;letter-spacing:.14em;text-transform:uppercase;color:var(--gold)}
.bar span:last-child{color:var(--dim)}
.line{margin:0;padding:18px 16px 8px;min-height:3.2rem;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:clamp(1rem,2.4vw,1.25rem);line-height:1.4}
.prompt{color:var(--gold);margin-right:.45rem}
.caret{display:inline-block;width:1px;height:.85em;margin-left:2px;background:var(--gold);vertical-align:-.05em;animation:blink 1.05s steps(1) infinite}
@keyframes blink{50%{opacity:0}}
.controls{display:flex;flex-wrap:wrap;align-items:center;gap:10px 12px;padding:8px 16px 14px}
.controls [role="radiogroup"],.queries{display:flex;flex-wrap:wrap;gap:6px}
.controls button{font:500 .75rem/1 Inter,system-ui,sans-serif;color:var(--muted);background:transparent;border:1px solid var(--line);border-radius:999px;padding:8px 12px;cursor:pointer}
.controls button[aria-checked="true"],.controls button[aria-pressed="true"]{color:#140e02;background:var(--gold);border-color:var(--gold)}
.queries{flex:1 1 100%}
.queries button{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:0;text-transform:none}
.rows{list-style:none;margin:0;padding:0 10px 12px;counter-reset:rank;transition:opacity .25s}
.rows :global(li){counter-increment:rank;display:grid;grid-template-columns:2.4rem 1fr;gap:2px 10px;align-items:baseline;margin:0 6px 6px;padding:10px 12px;border:1px solid transparent;border-radius:10px;background:rgba(255,255,255,.02)}
.rows :global(li)::before{content:counter(rank,decimal-leading-zero);grid-row:1 / span 2;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:.78rem;color:var(--dim);padding-top:.35rem}
.rows :global(.nm){font-size:1rem;color:var(--ink)}
.rows :global(.dt){font-size:.82rem;color:var(--muted)}
.rows :global(.is-expected){border-color:rgba(243,200,113,.45);background:rgba(243,200,113,.06)}
.rows :global(.is-expected) :global(.nm){color:var(--gold)}
.more{margin:16px 0 0;font-size:.82rem;letter-spacing:.08em;text-transform:uppercase}
.more a{color:var(--gold);text-decoration:none;border-bottom:1px solid rgba(243,200,113,.45)}
@media (prefers-reduced-motion: reduce){
  .caret{animation:none}
  .rows{transition:none}
}
</style>
