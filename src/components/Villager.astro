---
import type { Person } from "../data/island";
import { sprites } from "./sprites";

interface Props {
  person: Person;
  order: number;
  x: number;
  y: number;
}
const { person, order, x, y } = Astro.props;
const art = sprites.villagers[person.id];
const eager = order < 1;
const height = 58;
const native: Record<string, { sw: number; ww?: number }> = {
  picker: { sw: 98 },
  trader: { sw: 125 },
  carer: { sw: 108 },
  kirana1: { sw: 95, ww: 92 },
  kirana2: { sw: 95 },
  seller1: { sw: 120, ww: 116 },
  seller2: { sw: 120 },
  jarvis: { sw: 116 },
  coach: { sw: 125 },
  scout: { sw: 117 },
  builder: { sw: 151, ww: 140 },
};
const frame = native[person.id] ?? { sw: 110 };
const standW = Math.round((frame.sw * height) / 192);
const walkW = Math.round(((frame.ww ?? frame.sw) * height) / 192);
---

<g class="isl-npc" data-order={order} transform={`translate(${x} ${y})`} aria-hidden="true">
  {art?.stand ? (
    <g class:list={["fig", { "has-walk": Boolean(art.walk) }]}>
      <ellipse cx="0" cy="3" rx={standW * 0.34} ry="4.5" fill="#000" opacity="0.22" />
      <image
        class="stand"
        alt=""
        role="presentation"
        href={eager ? art.stand : undefined}
        data-src={eager ? undefined : art.stand}
        x={-standW / 2}
        y={4 - height}
        width={standW}
        height={height}
      />
      {art.walk && (
        <image
          class="step"
          alt=""
          role="presentation"
          href={eager && art.walk ? art.walk : undefined}
          data-src={eager ? undefined : art.walk}
          x={-walkW / 2}
          y={4 - height}
          width={walkW}
          height={height}
        />
      )}
    </g>
  ) : (
    <g>
      <ellipse cx="1" cy="2" rx="7" ry="3" fill="#000" opacity="0.2" />
      <ellipse cx="0" cy="-8" rx="6" ry="8" fill={person.color} />
      <circle cx="0" cy="-18" r="4" fill="#efd0a8" />
    </g>
  )}
</g>
