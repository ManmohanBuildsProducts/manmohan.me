---
import type { Person } from "../data/island";
import { sprites } from "./sprites";

interface Props {
  person: Person;
  order: number;
  x: number;
  y: number;
}
const { person, order, x, y } = Astro.props;
const art = sprites.villagers[person.id];
const eager = order <= 1;
---

<g class="isl-npc" data-order={order} transform={`translate(${x} ${y})`} aria-hidden="true">
  {art?.stand ? (
    <g class:list={["fig", { "has-walk": Boolean(art.walk) }]}>
      <ellipse cx="1" cy="2" rx="11" ry="4" fill="#000" opacity="0.28" />
      <image
        class="stand"
        href={eager ? art.stand : undefined}
        data-src={eager ? undefined : art.stand}
        x="-26"
        y="-50"
        width="52"
        height="52"
      />
      {art.walk && (
        <image
          class="step"
          href={eager && art.walk ? art.walk : undefined}
          data-src={eager ? undefined : art.walk}
          x="-26"
          y="-50"
          width="52"
          height="52"
        />
      )}
    </g>
  ) : (
    <g>
      <ellipse cx="1" cy="2" rx="7" ry="3" fill="#000" opacity="0.2" />
      <ellipse cx="0" cy="-8" rx="6" ry="8" fill={person.color} />
      <circle cx="0" cy="-18" r="4" fill="#efd0a8" />
    </g>
  )}
</g>
