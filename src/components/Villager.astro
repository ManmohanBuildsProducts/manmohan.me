---
import type { Person } from "../data/island";
import { sprites } from "./sprites";

interface Props {
  person: Person;
  order: number;
  x: number;
  y: number;
}
const { person, order, x, y } = Astro.props;
const look = person.sprite ?? person.id;
const art = sprites.villagers[look];
const eager = order < 1;
const height = 58;
const working = person.era === "gobble";
const step: Record<string, [number, number]> = {
  blinkit: [14, 8],
  bijak: [12, 10],
  tago: [-10, 10],
  badho: [8, 14],
  gobble: [-14, 8],
};
const [sx, sy] = step[person.era] ?? [8, 8];
const native: Record<string, { sw: number; ww?: number }> = {
  picker: { sw: 98 },
  trader: { sw: 125 },
  carer: { sw: 108 },
  kirana1: { sw: 95, ww: 92 },
  kirana2: { sw: 95 },
  seller1: { sw: 120, ww: 116 },
  seller2: { sw: 120 },
  coach: { sw: 125 },
  scout: { sw: 117 },
  builder: { sw: 151, ww: 140 },
};
const frame = native[look] ?? { sw: 110 };
const standW = Math.round((frame.sw * height) / 192);
const walkW = Math.round(((frame.ww ?? frame.sw) * height) / 192);
const spriteTag = (kind: "stand" | "step", href: string, width: number) =>
  `<image class="${kind}" alt="" role="presentation" ${eager ? `href="${href}"` : `data-src="${href}"`} x="${-width / 2}" y="${4 - height}" width="${width}" height="${height}"></image>`;
---

<g
  class="isl-npc"
  data-order={order}
  data-home={person.era}
  style={`--step-x:${sx}px;--step-y:${sy}px`}
  transform={`translate(${x} ${y})`}
  aria-hidden="true"
>
  {art?.stand ? (
    <g class:list={["fig", { "has-walk": Boolean(art.walk) }]}>
      <g
        class:list={["bob", "life", { stroll: person.drift !== 0, work: working }]}
        style={`--dx:${Math.round(person.drift * 1.35)}px;--dy:${Math.round(person.drift * 0.55)}px;--walk:${7 + (order % 4)}s;--delay:${(order * 0.37).toFixed(2)}s`}
      >
      <ellipse cx="0" cy="3" rx={standW * 0.34} ry="4.5" fill="#000" opacity="0.22" />
      <Fragment set:html={spriteTag("stand", art.stand, standW)} />
      {art.walk && <Fragment set:html={spriteTag("step", art.walk, walkW)} />}
      </g>
    </g>
  ) : (
    <g>
      <ellipse cx="1" cy="2" rx="7" ry="3" fill="#000" opacity="0.2" />
      <ellipse cx="0" cy="-8" rx="6" ry="8" fill={person.color} />
      <circle cx="0" cy="-18" r="4" fill="#efd0a8" />
    </g>
  )}
</g>
