---
import type { Person } from "../data/island";

interface Props {
  person: Person;
  order: number;
}
const { person, order } = Astro.props;
const dur = (4 + Math.abs(person.drift) / 6).toFixed(2);
---

<g
  class="isl-npc"
  data-order={order}
  data-id={person.id}
  aria-hidden="true"
>
  <g transform={`translate(${person.x} ${person.y})`}>
    <ellipse class="ring" cx="0" cy="4" rx="16" ry="6" fill="none" />
    <g class="walker" data-drift={person.drift} style={`--dx:${person.drift}px;--dur:${dur}s`}>
      <ellipse cx="0" cy="2" rx="8" ry="2.5" fill="#000" opacity="0.22" />
      <rect x="-5" y="-15" width="10" height="16" rx="3.5" fill={person.color} />
      <circle cx="0" cy="-19" r="5" fill="#E2BE96" stroke="#2A2216" stroke-width="0.8" />
      {person.crew && (
        <g>
          <path d="M -6.5 -21 Q 0 -31 6.5 -21 Z" fill="#E9B949" stroke="#2A2216" stroke-width="0.8" />
          <line x1="0" y1="-30" x2="0" y2="-36" stroke="#2A2216" stroke-width="1.15" />
          <circle cx="0" cy="-37.5" r="2.3" fill="#E9B949" stroke="#2A2216" stroke-width="0.6" />
        </g>
      )}
    </g>
    <circle cx="0" cy="-12" r="22" fill="transparent" />
  </g>
</g>
