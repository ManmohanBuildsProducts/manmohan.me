<div class="stage">
  <div class="isl-frame world-frame" data-world>
    <canvas aria-hidden="true"></canvas>
    <div class="world-labels" data-labels></div>
    <img class="world-still" src="/island-still.webp" alt="The island of five ages, from Blinkit to GobbleCube, floating in the sea." fetchpriority="high" decoding="async" />
    <div class="isl-banner" data-banner hidden>
      <p class="banner-k" data-banner-k></p>
      <p class="banner-t" data-banner-t></p>
      <p class="banner-d" data-banner-d></p>
    </div>
  </div>
</div>

<script>
  import "../scripts/island.ts";

  const frame = document.querySelector<HTMLElement>("[data-world]");
  const reduce = document.documentElement.dataset.motion === "reduce";

  function showStill() {
    document.documentElement.dataset.world = "still";
  }

  if (!frame || reduce) showStill();
  else {
    let started = false;
    const boot = () => {
      if (started) return;
      started = true;
      import("../scripts/world.ts")
        .then((mod) => mod.mount(frame))
        .then(() => {
          if (frame.dataset.mode === "still") showStill();
        })
        .catch(() => showStill());
    };
    const arm = () => {
      window.addEventListener("pointerdown", boot, { once: true });
      window.addEventListener("keydown", boot, { once: true });
      window.addEventListener("scroll", boot, { once: true, capture: true });
      const idle = window.requestIdleCallback ?? ((fn: () => void) => window.setTimeout(fn, 400));
      idle(() => window.setTimeout(boot, 2200), { timeout: 4000 });
    };
    if (document.readyState === "complete") arm();
    else window.addEventListener("load", arm, { once: true });
  }
</script>
