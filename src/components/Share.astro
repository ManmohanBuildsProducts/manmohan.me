---
interface Props { title: string; url: string }
const { title, url } = Astro.props;
const u = encodeURIComponent(url), t = encodeURIComponent(title);
---
<div class="share">
  <span>Share</span>
  <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${u}`} target="_blank" rel="noopener">LinkedIn</a>
  <a href={`https://x.com/intent/post?url=${u}&text=${t}`} target="_blank" rel="noopener">X</a>
  <a href={`https://wa.me/?text=${t}%20${u}`} target="_blank" rel="noopener">WhatsApp</a>
  <button type="button" data-url={url}>Copy link</button>
</div>
<script>
  document.querySelectorAll<HTMLButtonElement>('.share button[data-url]').forEach((b) => {
    b.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(b.dataset.url!); b.textContent = 'Copied'; }
      catch { b.textContent = 'Copy failed'; }
      setTimeout(() => (b.textContent = 'Copy link'), 1800);
    });
  });
</script>
<style>
.share{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin:56px 0 0;padding-top:24px;border-top:1px solid var(--line);font-size:.8rem}
.share span{color:var(--dim);letter-spacing:.14em;text-transform:uppercase;font-size:.7rem;margin-right:6px}
.share a,.share button{font:inherit;color:var(--ink);background:none;border:1px solid #2a2930;border-radius:999px;padding:6px 14px;text-decoration:none;cursor:pointer;transition:border-color .3s,color .3s}
.share a:hover,.share button:hover{border-color:var(--gold);color:var(--gold)}
</style>
