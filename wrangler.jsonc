{
  "name": "manmohan-me",
  "compatibility_date": "2026-10-01",
  "main": "./worker.js",
  "previews": {},
  "build": {
    "command": "if [ ! -d dist ]; then npm ci && npm run build; fi"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
